# 非必需。AI 配置推荐在应用内"AI 助手 → ⚙ 设置"完成，会写入 ai-config.json（优先于此文件）。
# 以下仅作为无配置文件时的后备（.env / server.ts 启动时自动加载）：

# ---- 模型路由（默认千帆/百度智能云 DeepSeek） ----
LLM_PROVIDER=qianfan
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=bce-v3/your-qianfan-access-token
QIANFAN_MODEL=deepseek-v4-flash-0731

# 切回本地 Ollama：
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# 切其他云模型（OpenAI 等）：
# LLM_PROVIDER=openai
# CLOUD_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# 显式完整指定：
# MASTRA_MODEL=openai/gpt-4o-mini

# ---- Mastra server ----
# MASTRA_PORT=4111        # 独立 server 端口（默认 4111）
# DISABLE_MASTRA_SERVER=1 # 禁用 Mastra server 启动（排查用）
# KEYBOARD_DB_PATH=       # SQLite 数据库路径（默认项目根 keyboard_stats.db）